+/// Makes `runtime` provide the WebGPU imports, within what `ctx` grants, to
+/// the instances it creates for modules that import them.
+#[cfg(feature = "webgpu")]
+fn wrap_runtime_with_webgpu(
+    ctx: &wasmer_webgpu::WebGpuCtx,
+    runtime: Arc<dyn Runtime + Send + Sync>,
+) -> Arc<dyn Runtime + Send + Sync> {
+    Arc::new(OverriddenRuntime::new(runtime).with_instantiation_hook(ctx.runtime_hooks()))
+}
