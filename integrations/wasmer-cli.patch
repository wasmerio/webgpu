+#[cfg(all(test, feature = "webgpu"))]
+mod webgpu_tests {
+    use std::sync::Arc;
+
+    use super::*;
+    use wasmer_wasix::{
+        PluggableRuntime, WasiError, runtime::task_manager::tokio::TokioTaskManager,
+    };
+
+    /// Checks the ABI version, then creates and releases a WebGPU instance.
+    fn webgpu_guest() -> Vec<u8> {
+        wat2wasm(
+            br#"(module
+                (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
+                (import "wasmer_webgpu_v0" "wasmer_wgpu_abi_version" (func $abi_version (result i32)))
+                (import "wasmer_webgpu_v0" "wgpuCreateInstance" (func $create_instance (param i32) (result i32)))
+                (import "wasmer_webgpu_v0" "wasmer_wgpu_instance_release" (func $release_instance (param i32) (result i32)))
+
+                (memory (export "memory") 1)
+
+                (func (export "_start")
+                    (local $instance i32)
+
+                    (if (i32.shr_u (call $abi_version) (i32.const 16))
+                        (then (call $proc_exit (i32.const 10))))
+
+                    (local.set $instance (call $create_instance (i32.const 0)))
+                    (if (i32.eqz (local.get $instance))
+                        (then (call $proc_exit (i32.const 11))))
+
+                    (if (i32.ne (call $release_instance (local.get $instance)) (i32.const 1))
+                        (then (call $proc_exit (i32.const 12))))
+                )
+            )"#,
+        )
+        .expect("guest wat parses")
+        .into_owned()
+    }
+
+    #[test]
+    fn cli_webgpu_runtime_wrapper_runs_wasix_guest() {
+        let wasm = webgpu_guest();
+        let store = Store::default();
+        let module = Module::new(&store, &wasm).expect("guest module compiles");
+        assert!(wasmer_webgpu::module_needs_webgpu(&module).is_some());
+
+        let tokio_runtime = tokio::runtime::Builder::new_multi_thread()
+            .enable_all()
+            .build()
+            .expect("tokio runtime starts");
+        let _guard = tokio_runtime.enter();
+        let mut base_runtime = PluggableRuntime::new(Arc::new(TokioTaskManager::new(
+            tokio_runtime.handle().clone(),
+        )));
+        base_runtime.set_engine(store.engine().clone());
+
+        let ctx = wasmer_webgpu::WebGpuCtx::default();
+        let runtime = wrap_runtime_with_webgpu(&ctx, Arc::new(base_runtime));
+        let mut import_store = runtime.new_store();
+        let mut import_store_mut = import_store.as_store_mut();
+        let (imports, _state) = runtime
+            .additional_imports(&module, &mut import_store_mut)
+            .expect("webgpu imports are created");
+        assert!(imports.exists("wasmer_webgpu_v0", "wgpuCreateInstance"));
+
+        let result = WasiRunner::new().run_wasm(
+            RuntimeOrEngine::Runtime(runtime),
+            "webgpu-cli-smoke",
+            module,
+            ModuleHash::new(&wasm),
+        );
+
+        match result {
+            Ok(()) => {}
+            Err(err) => {
+                if let Some(WasiError::Exit(code)) = err.downcast_ref::<WasiError>() {
+                    panic!("guest exited with status {code}");
+                }
+                panic!("guest failed: {err:?}");
+            }
+        }
+    }
