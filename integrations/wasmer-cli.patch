+            Ok(WindowExit::Finished(result)) => exit_with_wasi_exit_code(result),
+            // Closing the window is how the user quits a program that draws.
+            Ok(WindowExit::Closed) => {
+                control.terminate_all();
+                std::process::exit(0)
+            }
+            Err(error) => exit_with_wasi_exit_code(Err(error)),
+        }
+    }
